{
  "type": "struct",
  "fields": [
    {
      "name": "id_cliente",
      "type": "string",
      "nullable": true,
      "metadata": {
        "comment": "Identificador do cliente (prefixo cus_)."
      }
    },
    {
      "name": "nome_cliente",
      "type": "string",
      "nullable": true,
      "metadata": {
        "comment": "Nome do cliente, sem pronome de tratamento."
      }
    },
    {
      "name": "estado",
      "type": "string",
      "nullable": true,
      "metadata": {
        "comment": "Sigla da UF do cliente, por exemplo SP, RJ, MG."
      }
    },
    {
      "name": "nome_estado",
      "type": "string",
      "nullable": true,
      "metadata": {
        "comment": "Nome completo do estado (fonte: API do IBGE)."
      }
    },
    {
      "name": "regiao",
      "type": "string",
      "nullable": true,
      "metadata": {
        "comment": "Regi\u00e3o do Brasil: Norte, Nordeste, Centro-Oeste, Sudeste ou Sul (fonte: API do IBGE)."
      }
    },
    {
      "name": "total_compras",
      "type": "long",
      "nullable": true,
      "metadata": {
        "comment": "Quantidade de compras do cliente no per\u00edodo."
      }
    },
    {
      "name": "receita",
      "type": "decimal(20,2)",
      "nullable": true,
      "metadata": {
        "comment": "Receita total gerada pelo cliente no per\u00edodo, em reais (R$)."
      }
    },
    {
      "name": "ticket_medio",
      "type": "decimal(11,2)",
      "nullable": true,
      "metadata": {
        "comment": "Valor m\u00e9dio por compra do cliente, em reais (R$)."
      }
    },
    {
      "name": "primeira_compra",
      "type": "date",
      "nullable": true,
      "metadata": {
        "comment": "Data da primeira compra do cliente."
      }
    },
    {
      "name": "ultima_compra",
      "type": "date",
      "nullable": true,
      "metadata": {
        "comment": "Data da compra mais recente do cliente."
      }
    },
    {
      "name": "segmento_cliente",
      "type": "string",
      "nullable": true,
      "metadata": {
        "comment": "Segmento pela receita no per\u00edodo: VIP (a partir de R$ 22.000), TOP_TIER (R$ 17.000 a R$ 21.999,99) ou REGULAR (abaixo de R$ 17.000)."
      }
    },
    {
      "name": "ranking_receita",
      "type": "integer",
      "nullable": true,
      "metadata": {
        "comment": "Posi\u00e7\u00e3o do cliente no ranking de receita (1 = cliente que mais gerou receita)."
      }
    }
  ]
}