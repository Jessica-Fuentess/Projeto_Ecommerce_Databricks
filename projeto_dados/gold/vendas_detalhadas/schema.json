{
  "type": "struct",
  "fields": [
    {
      "name": "id_venda",
      "type": "string",
      "nullable": true,
      "metadata": {
        "comment": "Identificador da venda (prefixo sal_). Uma linha por venda."
      }
    },
    {
      "name": "data_venda",
      "type": "timestamp",
      "nullable": true,
      "metadata": {
        "comment": "Data e hora da venda."
      }
    },
    {
      "name": "data",
      "type": "date",
      "nullable": true,
      "metadata": {
        "comment": "Data da venda (sem hor\u00e1rio)."
      }
    },
    {
      "name": "dia_semana",
      "type": "string",
      "nullable": true,
      "metadata": {
        "comment": "Dia da semana em portugu\u00eas: Domingo, Segunda, Ter\u00e7a, Quarta, Quinta, Sexta, S\u00e1bado."
      }
    },
    {
      "name": "dia_semana_num",
      "type": "integer",
      "nullable": true,
      "metadata": {
        "comment": "N\u00famero do dia da semana para ordena\u00e7\u00e3o: 1 = Domingo ... 7 = S\u00e1bado."
      }
    },
    {
      "name": "hora",
      "type": "integer",
      "nullable": true,
      "metadata": {
        "comment": "Hora do dia da venda, de 0 a 23."
      }
    },
    {
      "name": "canal_venda",
      "type": "string",
      "nullable": true,
      "metadata": {
        "comment": "Canal da venda: ecommerce (site) ou loja_fisica."
      }
    },
    {
      "name": "id_produto",
      "type": "string",
      "nullable": true,
      "metadata": {
        "comment": "Identificador do produto (prefixo prd_)."
      }
    },
    {
      "name": "nome_produto",
      "type": "string",
      "nullable": true,
      "metadata": {
        "comment": "Nome do produto, ou \"Produto n\u00e3o cadastrado\". Produtos diferentes podem ter o mesmo nome; use id_produto para contar produtos."
      }
    },
    {
      "name": "categoria",
      "type": "string",
      "nullable": true,
      "metadata": {
        "comment": "Categoria do produto, ou \"N\u00e3o cadastrado\"."
      }
    },
    {
      "name": "marca",
      "type": "string",
      "nullable": true,
      "metadata": {
        "comment": "Marca do produto, ou \"N\u00e3o cadastrado\"."
      }
    },
    {
      "name": "faixa_preco",
      "type": "string",
      "nullable": true,
      "metadata": {
        "comment": "Faixa de pre\u00e7o do produto: PREMIUM, MEDIO ou BASICO. Vazia para produto n\u00e3o cadastrado."
      }
    },
    {
      "name": "produto_cadastrado",
      "type": "boolean",
      "nullable": true,
      "metadata": {
        "comment": "false quando o produto vendido n\u00e3o existe no cat\u00e1logo (problema de qualidade de dados)."
      }
    },
    {
      "name": "id_cliente",
      "type": "string",
      "nullable": true,
      "metadata": {
        "comment": "Identificador do cliente (prefixo cus_)."
      }
    },
    {
      "name": "nome_cliente",
      "type": "string",
      "nullable": true,
      "metadata": {
        "comment": "Nome do cliente, sem pronome de tratamento."
      }
    },
    {
      "name": "estado",
      "type": "string",
      "nullable": true,
      "metadata": {
        "comment": "Sigla da UF do cliente, por exemplo SP, RJ, MG."
      }
    },
    {
      "name": "regiao",
      "type": "string",
      "nullable": true,
      "metadata": {
        "comment": "Regi\u00e3o do Brasil do cliente: Norte, Nordeste, Centro-Oeste, Sudeste ou Sul."
      }
    },
    {
      "name": "segmento_cliente",
      "type": "string",
      "nullable": true,
      "metadata": {
        "comment": "Segmento do cliente no per\u00edodo: VIP, TOP_TIER ou REGULAR (mesma regra de gold.clientes_segmentacao)."
      }
    },
    {
      "name": "quantidade",
      "type": "long",
      "nullable": true,
      "metadata": {
        "comment": "Unidades vendidas nesta venda."
      }
    },
    {
      "name": "preco_unitario",
      "type": "decimal(10,2)",
      "nullable": true,
      "metadata": {
        "comment": "Pre\u00e7o cobrado por unidade, em reais (R$)."
      }
    },
    {
      "name": "receita",
      "type": "decimal(10,2)",
      "nullable": true,
      "metadata": {
        "comment": "Receita bruta da venda em reais (R$) = quantidade \u00d7 pre\u00e7o unit\u00e1rio. Somar para totalizar."
      }
    },
    {
      "name": "venda_antes_do_cadastro",
      "type": "boolean",
      "nullable": true,
      "metadata": {
        "comment": "true quando a venda aconteceu antes da data de cria\u00e7\u00e3o do produto (problema de qualidade de dados)."
      }
    }
  ]
}